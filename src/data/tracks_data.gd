static func track_by_id(id: String) -> Dictionary:
	for t in TRACKS:
		if t["id"] == id:
			return t
	return TRACKS[0]


static func cup_by_id(id: String) -> Dictionary:
	for c in CUPS:
		if c["id"] == id:
			return c
	return CUPS[0]
